[TEMPLATE]
# Copy to .env and fill in. Everything here is validated at boot by
# src/config/env.js: a missing or malformed value stops the server with a reason
# instead of failing later on the first request.

NODE_ENV=development
PORT=4000

# MongoDB: a local mongod or an Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/echo

# 16+ characters. Changing this signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# Where the frontend runs. It is the CORS origin, and the base of the default
# Google redirect URI.
CLIENT_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=12

# Gemini (Google AI Studio) for study packs and Chat with Echo. Leave the key
# empty to use the built-in rule-based generator; chat then says so instead of
# answering from the model.
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# --- Google sign-in ---------------------------------------------------------
# Create an OAuth client of type "Web application" at
#   https://console.cloud.google.com/apis/credentials
# and register both redirect URIs on it, exactly:
#   http://localhost:5173/api/auth/google/callback      (development)
#   https://your-domain/api/auth/google/callback        (production)
# With the id and secret empty, Google is offered nowhere: the sign-in page
# simply shows the email and password form.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Empty means <CLIENT_ORIGIN>/api/auth/google/callback, which is the
# path the frontend proxies to this server in development. If you set it, it
# must match a registered redirect URI character for character.
GOOGLE_REDIRECT_URI=

# Only for walking the flow against a local stub while testing. Never set these
# in production.
# GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# --- Deploying the API to Vercel --------------------------------------------
# Vercel reads no .env file: set these in Project → Settings → Environment
# Variables for the Production environment. api/[...path].js is the serverless
# entry point; there is no PORT to set, because nothing listens on one.
#
#   NODE_ENV=production
#     Required. It is what makes the session cookie SameSite=None; Secure, so a
#     frontend on another domain can actually log in.
#
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/echo
#     A hosted cluster — a local mongod is not reachable from a serverless
#     function. MongoDB Atlas has a free tier that works with the existing
#     mongoose code. Allow 0.0.0.0/0 in Atlas network access: Vercel's IPs are
#     dynamic.
#
#   JWT_SECRET=<32+ random characters>
#   CLIENT_ORIGIN=https://your-frontend.vercel.app
#     The deployed frontend's origin. Needed for CORS when the browser calls
#     this API directly; when the frontend proxies /api to it instead, requests
#     are same-origin and this only matters for the Google redirect default.
#
#   AI_API_KEY=<Gemini key>       optional; empty falls back to the rule-based
#                                 generator
#
# Two platform limits worth knowing before you point the frontend at this:
#   * request bodies are capped at 4.5 MB by the platform, below the 5 MB the
#     app itself allows, so a very large document's extracted text can be
#     rejected by Vercel before Express ever sees it;
#   * AI pack generation happens inside the request. api/[...path].js asks for
#     maxDuration 60 so a slow model call can finish — if your plan caps
#     functions lower than that, uploads will time out at the cap.
