# Echo frontend environment — read by Vite at dev and build time.
#
# Vite inlines every VITE_* value into the built bundle, so this is the
# browser's configuration. Never put a secret here.
#
# Where the API lives, as the BROWSER sees it.
#
#   empty  -> requests go to "/api/..." on this same origin. In development
#             vite.config.js proxies that to http://localhost:4000; in
#             production vercel.json rewrites it through to the backend, so the
#             httpOnly session cookie stays first-party and login works.
#
#   set    -> requests go straight to that domain, e.g.
#             VITE_API_URL=https://echo-api.onrender.com
#             The production server then needs CLIENT_ORIGIN set to this
#             frontend's origin (it already allows that origin with credentials
#             and sends its cookie as SameSite=None; Secure).
VITE_API_URL=
