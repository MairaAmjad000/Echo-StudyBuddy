# Echo frontend — environment variables.
#
# Vite inlines every VITE_* value into the built bundle, so this file is the
# browser's configuration and must never hold a secret.

# Where the API lives, as seen by the BROWSER.
#
# Leave it empty when the frontend and the API share an origin — the normal
# Vercel setup, where vercel.json rewrites /api/* through to the backend.
# Requests then go to "/api/...", stay same-origin, and the httpOnly session
# cookie rides along untouched.
#
# Set it only when the API is on its own domain, for example:
#   VITE_API_URL=https://echo-api.onrender.com
# A production server already sends its session cookie as SameSite=None;
# Secure and allows CLIENT_ORIGIN with credentials, so the only thing left to
# do on the backend is point CLIENT_ORIGIN at this frontend's origin. (A
# SameSite=Lax cookie is never sent cross-site, which used to make login look
# like it worked and then immediately read as signed out.)
VITE_API_URL=
